<!doctype html>
<html lang="{{ site.language }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#fbf7f0">

  <script>
    // Hell/Dunkel sofort setzen, damit beim Laden nichts aufblitzt.
    (function () {
      try {
        var stored = localStorage.getItem("pf-theme");
        var theme = stored === "dark" || stored === "light"
          ? stored
          : (window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
        document.documentElement.setAttribute("data-theme", theme);
      } catch (error) {
        document.documentElement.setAttribute("data-theme", "light");
      }
    })();
  </script>

  <title>{% if isHome %}{{ title }}{% else %}{{ title }} · {{ site.name }}{% endif %}</title>
  <meta name="description" content="{{ description or site.description }}">

  <link rel="canonical" href="{{ site.url }}{{ page.url }}">
  {% if noindex %}<meta name="robots" content="noindex">{% endif %}

  <meta property="og:type" content="website">
  <meta property="og:site_name" content="{{ site.name }}">
  <meta property="og:locale" content="de_AT">
  <meta property="og:title" content="{% if isHome %}{{ title }}{% else %}{{ title }} · {{ site.name }}{% endif %}">
  <meta property="og:description" content="{{ description or site.description }}">
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  <meta property="og:image" content="{{ site.url }}/assets/img/og-image.jpg">
  <meta name="twitter:card" content="summary_large_image">

  <link rel="icon" href="{{ '/favicon.svg' | link }}" type="image/svg+xml">
  <link rel="apple-touch-icon" href="{{ '/apple-touch-icon.png' | link }}">

  <link rel="preload" href="{{ '/assets/fonts/instrument-sans-latin.woff2' | link }}" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="{{ '/assets/fonts/fraunces-latin.woff2' | link }}" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="{{ '/assets/css/main.css' | link }}?v={{ buildId }}">

  {% if isHome %}
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "LodgingBusiness",
        "name": "{{ site.name }}",
        "description": "{{ site.description }}",
        "url": "{{ site.url }}/",
        "telephone": "{{ site.phone }}",
        "email": "{{ site.email }}",
        "image": "{{ site.url }}/assets/img/hero-1200.jpg",
        "priceRange": "€€",
        "checkinTime": "14:00",
        "checkoutTime": "10:00",
        "petsAllowed": true,
        "address": {
          "@type": "PostalAddress",
          "streetAddress": "{{ site.address.street }}",
          "postalCode": "{{ site.address.postalCode }}",
          "addressLocality": "{{ site.address.city }}",
          "addressRegion": "Südtirol",
          "addressCountry": "IT"
        },
        "aggregateRating": {
          "@type": "AggregateRating",
          "ratingValue": "{{ site.rating.value }}",
          "bestRating": "{{ site.rating.max }}",
          "reviewCount": "{{ site.rating.count }}"
        }
      }
    </script>
  {% endif %}
</head>
<body>
  <a class="skip-link" href="#main">Zum Inhalt springen</a>

  {% include "partials/header.njk" %}

  <main id="main">
    {{ content | safe }}
  </main>

  {% include "partials/footer.njk" %}

  {% include "partials/lightbox.njk" %}

  <script src="{{ '/assets/js/main.js' | link }}?v={{ buildId }}" defer></script>
</body>
</html>
